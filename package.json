{
  "name": "@arcade-cabinet/maze-core",
  "version": "0.1.0",
  "description": "Engine-agnostic maze generation for arcade-cabinet fleet games: seeded grid mazes, rail-node geometry, multi-layer topology with provable cross-layer solvability, and curved-wall outlines. Extracted from Beppo-Laughs.",
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "@types/seedrandom": "^3.0.8",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
